generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  TRAVELER
  HOST
}

enum StayStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model User {
  id            String         @id @default(uuid())
  email         String         @unique
  passwordHash  String
  name          String?
  avatarUrl     String?
  role          UserRole?
  hostProfile   HostProfile?
  stayRequests  StayRequest[]  @relation("GuestStayRequests")
  hostingStays  StayRequest[]  @relation("HostStayRequests")
  conversationsAsHost Conversation[] @relation("HostConversation")
  conversationsAsGuest Conversation[] @relation("GuestConversation")
  messages      Message[]
  reviewsAuthored Review[]     @relation("AuthoredReviews")
  reviewsReceived Review[]     @relation("TargetReviews")
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model HostProfile {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id])
  bio       String?
  city      String?
  country   String?
  places    Place[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Place {
  id            String        @id @default(uuid())
  hostProfileId String
  hostProfile   HostProfile   @relation(fields: [hostProfileId], references: [id])
  title         String
  description   String?
  city          String
  country       String
  address       String?
  capacity      Int?
  pricePerNight Int?
  stayRequests  StayRequest[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model StayRequest {
  id            String      @id @default(uuid())
  placeId       String
  place         Place       @relation(fields: [placeId], references: [id])
  guestId       String
  guest         User        @relation("GuestStayRequests", fields: [guestId], references: [id])
  hostId        String
  host          User        @relation("HostStayRequests", fields: [hostId], references: [id])
  checkIn       DateTime?
  checkOut      DateTime?
  message       String?
  status        StayStatus  @default(PENDING)
  roomId        String?
  conversation  Conversation? @relation("StayRequestConversation")
  reviews       Review[]     @relation("StayRequestReviews")
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model Conversation {
  id            String       @id @default(uuid())
  stayRequestId String?      @unique
  stayRequest   StayRequest? @relation("StayRequestConversation", fields: [stayRequestId], references: [id])
  hostId        String
  host          User         @relation("HostConversation", fields: [hostId], references: [id])
  guestId       String
  guest         User         @relation("GuestConversation", fields: [guestId], references: [id])
  messages      Message[]
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  senderId       String
  sender         User         @relation(fields: [senderId], references: [id])
  content        String
  createdAt      DateTime     @default(now())
}

model Review {
  id            String   @id @default(uuid())
  authorId      String
  author        User     @relation("AuthoredReviews", fields: [authorId], references: [id])
  targetUserId  String
  targetUser    User     @relation("TargetReviews", fields: [targetUserId], references: [id])
  stayRequestId String?
  stayRequest   StayRequest? @relation("StayRequestReviews", fields: [stayRequestId], references: [id])
  rating        Int
  comment       String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}
